{
    "format_version": "1.10.0",
    "animation_controllers": {
      "controller.animation.chocobo_sit": {
      "initial_state": "default",
        "states": {
          "default": {
            "transitions": [
              {
              "sit": "query.is_sitting && query.is_tamed"
            }
          ]
        },
        "sit": {
          "transitions": [
            {
            "default": "(1.0)"
          }
        ],
        "on_entry":[
          "@s minecraft:chocobo_mount_end"
          ]
        }
      }
    },
    "controller.animation.chocobo_sit_end": {
      "initial_state": "default",
        "states": {
          "default": {
            "transitions": [
              {
              "sit_end": "!query.is_sitting && query.is_tamed"
            }
          ]
        },
        "sit_end": {
          "transitions": [
            {
            "default": "(1.0)"
          }
        ],
        "on_entry":[
          "@s minecraft:chocobo_mount_start"
          ]
        }
      }
    }
  }
}