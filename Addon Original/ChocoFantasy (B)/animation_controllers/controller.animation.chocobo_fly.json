{
    "format_version": "1.10.0",
    "animation_controllers": {
      "controller.animation.chocobo_fly_start": {
        "initial_state": "default",
          "states": {
            "default": {
              "transitions": [
                {
                "fly_start": "query.is_fire_immune && (query.variant == 1)"
              }
            ]
          },
          "fly_start": {
            "transitions": [
              {
              "default": "(1.0)"
            }
          ],
          "on_entry":[
            "@s minecraft:chocobo_fly_start"
          ]
        }
      }
    },
    "controller.animation.chocobo_fly": {
      "initial_state": "default",
        "states": {
          "default": {
            "transitions": [
              {
              "fly": "(query.variant == 2) && (query.is_jumping == 1.0) && query.is_riding"
            }
          ]
        },
        "fly": {
          "transitions": [
            {
            "default": "(1.0)"
          }
        ],
        "on_entry":[
          "/effect @e[c=1,type=cf:chocobo_yellow_1,r=2] levitation 1000 2 true",
          "@s minecraft:falling_espera_start"
          ]
        }
      }
    },
    "controller.animation.chocobo_falling": {
      "initial_state": "default",
        "states": {
          "default": {
            "transitions": [
              {
              "falling": "(query.variant == 3) && (query.is_jumping == 1.0) && query.is_riding"
            }
          ]
        },
        "falling": {
          "transitions": [
            {
            "default": "(1.0)"
          }
        ],
        "on_entry":[
          "/effect @e[c=1,type=cf:chocobo_yellow_1,r=2] clear",
          "/effect @e[c=1,type=cf:chocobo_yellow_1,r=2] slow_falling 10000 1 true",
          "@s minecraft:fly_espera_start"
          ]
        }
      }
    },
    "controller.animation.chocobo_riding": {
      "initial_state": "default",
        "states": {
          "default": {
            "transitions": [
              {
              "riding": "!query.is_riding"
            }
          ]
        },
        "riding": {
          "transitions": [
            {
            "default": "(1.0)"
          }
        ],
        "on_entry":[
          "@s minecraft:fly_start"
          ]
        }
      }
    }
  }
}