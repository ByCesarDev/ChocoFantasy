          "variable.attack = Math.sin(variable.attack_time * 30.0);",
          "variable.roar_length = 1.0;"
        ]
      },
      "sound_effects": {
        "flutter": "mob.poison_dragon.flutter"
      },
      "render_controllers": [
        "controller.render.chocobos",
       {"controller.render.chocobos_saddle": "query.is_saddled"}
      ],
