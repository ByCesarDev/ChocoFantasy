{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "cf:chocobo_yellow_1",
      "materials": {
        "default": "skeleton"
      },
      "textures": {
        "default": "textures/entity/chocobos/chocobo_yellow_1",
        "saddle": "textures/entity/chocobos/chocobo_saddle"
      },
      "geometry": {
        "default": "geometry.chocobos",
        "saddle": "geometry.chocobos_saddle"
      },
      "animations": {
        "staticking": "animation.chocobo.static",
        "moving": "animation.chocobo.move",
        "flyng": "animation.chocobo.fly",
        "sitting": "animation.chocobo.sit",
        "look_at_target_default": "animation.poison_dragon.look_at_target.default",
        "look_at_target_gliding": "animation.poison_dragon.look_at_target.gliding",
        "look_at_target_swimming": "animation.poison_dragon.look_at_target.swimming",

        "static": "controller.animation.chocobo.static",
        "move": "controller.animation.chocobo.move",
        "fly": "controller.animation.chocobo.fly",
        "sit": "controller.animation.chocobo.sit",
        "look_at_target": "controller.animation.poison_dragon.look_at_target"
      },
      "scripts": {
        "animate": [
          "move", "static", "look_at_target", "fly", "sit"
        ],
