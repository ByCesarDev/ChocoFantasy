	"pistol_section@how_to_play_common.main_sections": {
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "pistol_button_toggle",
				"source_property_name": "#toggle_state",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"header_ss7@how_to_play_common.header": {
					"$text": "Magnum"
				}
			},
			{
				"image_ss13@how_to_play_common.image": {
					"texture": "textures/guns/magnum",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_ssss4@how_to_play_common.paragraph": {
					"$text": "A pistol that looked like a wild west revolver before, but now it is really a magnum, and it even acts like one! to fire, keep holding until you shoot. If you stop holding, the gun won't shoot. Think of this gun as the R8 Revolver."
				}
			},
			{
				"header_bs7@how_to_play_common.header": {
					"$text": "Glock-18"
				}
			},
			{
				"image_bs13@how_to_play_common.image": {
					"texture": "textures/guns/glock",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_sb4@how_to_play_common.paragraph": {
					"$text": "Glock-18 does 2-4 damage, even though you may see that as a disadvantage, it's accuracy and ammo capacity is very generous in tough situations."
				}
			},
			{
				"header_b7@how_to_play_common.header": {
					"$text": "Deagle"
				}
			},
			{
				"imagsse_b13@how_to_play_common.image": {
					"texture": "textures/guns/deagle",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_bsss4@how_to_play_common.paragraph": {
					"$text": "The Desert Eagle is a semi-automatic handgun notable for chambering the largest centerfire cartridge of any magazine-fed, self-loading pistol. It has 7 bullets and it does 16 damage. It is so powerful that it can shatter glass and glass panes!"
				}
			},
			{
				"padding_bsqqs4@how_to_play_common.padding": {}
			},
			{
				"header_b7@how_to_play_common.header": {
					"$text": "Deagle Gold Edition"
				}
			},
			{
				"imagsse_b13@how_to_play_common.image": {
					"texture": "textures/guns/deagleg",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_bsss4@how_to_play_common.paragraph": {
					"$text": "The Desert Eagle is a semi-automatic handgun notable for chambering the largest centerfire cartridge of any magazine-fed, self-loading pistol. It has 7 bullets and it does 18 damage. Just be careful of that recoil it has unlike it's normal counterpart. To craft, simply place a gold block and a normal Desert Eagle in the crafting table."
				}
			},
			{
				"padding_bsqqs4@how_to_play_common.padding": {}
			},
			{
				"header_b7@how_to_play_common.header": {
					"$text": "M9 Beretta"
				}
			},
			{
				"imagsse_b13@how_to_play_common.image": {
					"texture": "textures/guns/ber",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_bsss4@how_to_play_common.paragraph": {
					"$text": "The M9 Beretta or previously, \"Beretta\", is a Pistol that deals 5 damage and has 15 ammo capacity. It was revived by the power of @SBawls69."
				}
			},
			{
				"padding_bsqqs4@how_to_play_common.padding": {}
			},
			{
				"header_b7@how_to_play_common.header": {
					"$text": "Tactical USP"
				}
			},
			{
				"imagsse_b13@how_to_play_common.image": {
					"texture": "textures/guns/usp",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_bsss4@how_to_play_common.paragraph": {
					"$text": "The USP is a semi-automatic pistol developed in Germany by Heckler & Koch GmbH of Oberndorf am Neckar as a replacement for the P7 series of handguns. It has been bought back to the Add-on with the silence feature! to silence, put the USP into the crafting table. Your shots will be more accurate, but less damaging."
				}
			},
			{
				"padding_bsqqs4@how_to_play_common.padding": {}
			},
			{
				"header_b7@how_to_play_common.header": {
					"$text": "Tactical Silenced USP"
				}
			},
			{
				"imagsse_b13@how_to_play_common.image": {
					"texture": "textures/guns/usps",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_bsss4@how_to_play_common.paragraph": {
					"$text": "This is the silenced variant. Remember, your shots will not deal the same damage. To unsilence, put the USP back in the crafting table."
				}
			},
			{
				"padding_bsqqs4@how_to_play_common.padding": {}
			}
		]
	},
	"shotgun_section@how_to_play_common.main_sections": {
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "shotgun_button_toggle",
				"source_property_name": "#toggle_state",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"header_sss7@how_to_play_common.header": {
					"$text": "M3"
				}
			},
			{
				"image_6363613@how_to_play_common.image": {
					"texture": "textures/guns/m3",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_4zzzg@how_to_play_common.paragraph": {
					"$text": "The Benelli M3 is a semi-automatic shotgun that is known in a lot of FPS franchises such as Counter-Strike. The M3 does 20 damage, and also does knockback upon hitting an entity."
				}
			},
			{
				"padding_4@how_to_play_common.padding": {}
			},
			{
				"header_ssjjsss7@how_to_play_common.header": {
					"$text": "AA-12"
				}
			},
			{
				"image_636jsjs3613@how_to_play_common.image": {
					"texture": "textures/guns/aa12",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_4zz82pqoiqh73zg@how_to_play_common.paragraph": {
					"$text": "The Automatic AA-12 is a shotgun that spews out its powerful bullets every 3 ticks. You may call this shotgun OP but it's no longer OP when you know how to counter an AA-12 user properly."
				}
			},
			{
				"padding_4837pouhff27@how_to_play_common.padding": {}
			},
			{
				"header_ssjjsss7@how_to_play_common.header": {
					"$text": "M1881 Double Barrel"
				}
			},
			{
				"image_636jsjs3613@how_to_play_common.image": {
					"texture": "textures/guns/m1881",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_4zz82pqoiqh73zg@how_to_play_common.paragraph": {
					"$text": "The M1881 is a quick action close ranged shotgun that is used to kill 1 enemy at once. It can be powerful at close distance, but it will not deal damage on long range."
				}
			},
			{
				"padding_4837pouhff27@how_to_play_common.padding": {}
			}
		]
	},
	"smg_section@how_to_play_common.main_sections": {
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "smg_button_toggle",
				"source_property_name": "#toggle_state",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"header_744@how_to_play_common.header": {
					"$text": "Kriss Vector"
				}
			},
			{
				"image_636366313@how_to_play_common.image": {
					"texture": "textures/guns/kriss",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_ddd4@how_to_play_common.paragraph": {
					"$text": "Kriss is a little bit special of an SMG, it looks very different than the other ordinary SMG's, and while holding it, you feel as if this gun was designed for a Zombie Apocalypse."
				}
			},
			{
				"header_7fffff@how_to_play_common.header": {
					"$text": "UMP-45"
				}
			},
			{
				"image_1387537636366363@how_to_play_common.image": {
					"texture": "textures/guns/ump45",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_kddk4@how_to_play_common.paragraph": {
					"$text": "UMP45 is an SMG that is slower than all of the other SMG by just 1 tick, but it's damage and accuracy upclose will not disappoint you."
				}
			},
			{
				"padding_a4@how_to_play_common.padding": {}
			},
			{
				"header_a9@how_to_play_common.header": {
					"$text": "MP5"
				}
			},
			{
				"image_a15@how_to_play_common.image": {
					"texture": "textures/guns/mp5",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_a6@how_to_play_common.paragraph": {
					"$text": "The MP5 is the classic of SMG classes. It can make your enemies trimble in nostalgia or it can make you miss all of your shots."
				}
			},
			{
				"padding_a7@how_to_play_common.padding": {}
			},
			{
				"header_a11@how_to_play_common.header": {
					"$text": "P90"
				}
			},
			{
				"image_a17@how_to_play_common.image": {
					"texture": "textures/guns/p90",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_a8@how_to_play_common.paragraph": {
					"$text": "A submachine gun that is very known for rushing into somewhere and apparently, every russian loves this weapon. The P90 is a Belgian SMG that has 50 ammo capacity and can make you run faster than rifles. It is not recommended to spray this SMG from afar... Spray and Pray whilst you're flashbanged!"
				}
			},
			{
				"padding_a8@how_to_play_common.padding": {}
			},
			{
				"header_a11@how_to_play_common.header": {
					"$text": "UZI"
				}
			},
			{
				"image_a17@how_to_play_common.image": {
					"texture": "textures/guns/uzi",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_a8@how_to_play_common.paragraph": {
					"$text": "The UZI is a submachine gun that replaced the MAC-10 in order for the Add-on to be consistent. It has 25 ammo capacity, and the spraying of this SMG may be a little hard at first."
				}
			},
			{
				"padding_a8@how_to_play_common.padding": {}
			},
			{
				"header_a11@how_to_play_common.header": {
