					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_6363734@how_to_play_common.paragraph": {
					"$text": "Upon hitting someone with the brass knuckles, they will get nausea and a little damage. It also has a 1 second cool down and does 5 damage per attack (excluding the poison). This melee weapon was made to get ready for the Multiplayer update!"
				}
			},
			{
				"padding_4@how_to_play_common.padding": {}
			},
			{
				"header_7@how_to_play_common.header": {
					"$text": "Balisong "
				}
			},
			{
				"image_81644379913@how_to_play_common.image": {
					"texture": "textures/melee/butterfly",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_6363734@how_to_play_common.paragraph": {
					"$text": "Aka the butterfly knife, it is a knife that does 12 damage upon hit and it has \"open\" feature when equipping the closed variant."
				}
			},
			{
				"padding_4@how_to_play_common.padding": {}
			},
			{
				"header_7@how_to_play_common.header": {
					"$text": "Tomahawk"
				}
			},
			{
				"image_81644379913@how_to_play_common.image": {
					"texture": "textures/melee/tom",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_6363734@how_to_play_common.paragraph": {
					"$text": "The Tomahawk is a special Axe that can be used for melee and deal 7 damage, or you can throw it and deal 14-15 damage and get it after 45 ticks."
				}
			},
			{
				"padding_4@how_to_play_common.padding": {}
			},
			{
				"header_7@how_to_play_common.header": {
					"$text": "Kukri"
				}
			},
			{
				"image_81644379913@how_to_play_common.image": {
					"texture": "textures/melee/kukri",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_6363734@how_to_play_common.paragraph": {
					"$text": "A melee that was used to cut banana trees, now it turned into a melee manslaugher, dealing 19 damage upon hit and a 1 second cooldown because of how heavy and deadly it can be at times."
				}
			}
		]
