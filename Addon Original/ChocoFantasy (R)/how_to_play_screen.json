						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_a14@how_to_play_common.paragraph": {
					"$text": "The Schmidt Scout is a sniper rifle that can make you move faster than other snipers, but it does 18 damage to any target, and has a 10 bullet capacity."
				}
			},
			{
				"padding_a14@how_to_play_common.padding": {}
