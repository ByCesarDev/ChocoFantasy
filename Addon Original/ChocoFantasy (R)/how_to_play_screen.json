			{
				"image_a26@how_to_play_common.image": {
					"texture": "textures/guns/m200",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_a16@how_to_play_common.paragraph": {
					"$text": "A special Sniper Rifle that allows you to have a night-vision look whilst scoping, it can break glass and has a 7 ammo capacity. You have better accuracy while no scoping with this weapon, too!"
				}
			}
		]
