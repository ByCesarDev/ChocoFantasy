			},
			{
				"image_81644379913@how_to_play_common.image": {
					"texture": "textures/melee/karambit",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_6363734@how_to_play_common.paragraph": {
					"$text": "The indo knife, \"Karambit\", has a curved or hooked blade that is used to cut things efficient. It deals 24 damage (12 herts) and has a 2 second cool down."
				}
			},
			{
				"padding_4@how_to_play_common.padding": {}
			},
			{
				"header_7@how_to_play_common.header": {
					"$text": "M9 Bayonet"
				}
			},
			{
				"image_81644379913@how_to_play_common.image": {
					"texture": "textures/melee/m9",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_6363734@how_to_play_common.paragraph": {
					"$text": "The M9 Bayonet, officially known as the M9 Phrobis III, is a multi-purpose knife and bayonet officially adopted in 1986 by the United States. It has a 7-inch blade and is issued with a sheath designed to double as a wire cutter. Deals 15 damage."
				}
			},
			{
				"padding_4@how_to_play_common.padding": {}
			},
			{
				"header_7@how_to_play_common.header": {
					"$text": "Brass Knuckles "
