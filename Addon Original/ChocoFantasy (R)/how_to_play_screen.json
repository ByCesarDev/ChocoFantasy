				"image_a26@how_to_play_common.image": {
					"texture": "textures/guns/awp",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_a16@how_to_play_common.paragraph": {
					"$text": "The infamous AWP is very known for its 1 shot 1 kill policy. It has been added to replace it's lost brother, the \"AWM\". It will ignore walls, and hit everything in it's way."
				}
			},
			{
				"padding_a16@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "M200 CheyTac Intervention"
