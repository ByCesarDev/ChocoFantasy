	"rifle_section@how_to_play_common.main_sections": {
		"bindings": [
			{
				"binding_type": "view",
				"source_control_name": "rifle_button_toggle",
				"source_property_name": "#toggle_state",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"header_12@how_to_play_common.header": {
					"$text": "AK47"
				}
			},
			{
				"image_18@how_to_play_common.image": {
					"texture": "textures/guns/ak47",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_9@how_to_play_common.paragraph": {
					"$text": "The AK-47, officially known as the Avtomat Kalashnikova is a heavy assault rifle that is featured in many FPS games. This rifle is the counterpart to the M4A1. What you get from the AK is that your shots does more damage, and they have a lot of randomness."
				}
			},
			{
				"padding_9@how_to_play_common.padding": {}
			},
			{
				"header_12@how_to_play_common.header": {
					"$text": "AK47 Gold Edition"
				}
			},
			{
				"image_18@how_to_play_common.image": {
					"texture": "textures/guns/ak47g",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_9@how_to_play_common.paragraph": {
					"$text": "The AK-47, officially known as the Avtomat Kalashnikova is a heavy assault rifle that is featured in many FPS games. The Gold Edition is obtained by placing a Gold Block and a normal AK-47 in the crafting table. Your spread will be less, you will do +1 damage, and overall, you will look BADASS!"
				}
			},
			{
				"padding_9@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "M4A1"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/m4",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "Also known as M4 this rifle is the counterpart to the AK-47. Unlike the AK, your shots are more accurate, but less damaging and less fatal. To silence, sneak and then hit once."
				}
			},
			{
				"padding_10@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "Silenced M4A1"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/m4sil",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "The silenced version of the M4 can be obtained by putting a normal M4 into the crafting table. Will make your shots very accurate, less damaging and you will not be heard from afar, unlike the unsilenced M4. To unsilence, sneak and hit once."
				}
			},
			{
				"padding_10@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "Famas"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/famas",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "The famas is a bullpup-styled assault rifle designed and manufactured in France. It is the Galil's counterpart. The famas is similar to the M4A1 and the AK-47, but it just deals less damage than the M4 and the accuracy of it is worse than the M4."
				}
			},
			{
				"padding_10@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "IMI Galil"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/galil",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "The IMI Galil is a replacement for the old, Galil AR. The IMI Galil is a worse version of its old Galil AR counterpart, yet it is surprisingly similar to the AK-47... just less damage and worse accuracy."
				}
			},
			{
				"padding_10@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "Scar-L"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/scar",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "The Scar-L is a heavy assault rifle that acts like and M4A1 and an AK-47 at the same time, your shots may be inaccurate, but you can still see where they are going. And in terms of damage, it's in the middle of the M4 and the AK."
				}
			},
			{
				"padding_10@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "G36C"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/g36c",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "An old time favourite, the \"G36C\" is now back to the Add-on, and it's better and stronger than before!"
				}
			},
			{
				"padding_10@how_to_play_common.padding": {}
			},
			{
				"header_13@how_to_play_common.header": {
					"$text": "AUG"
				}
			},
			{
				"image_19@how_to_play_common.image": {
					"texture": "textures/guns/aug",
					"size": [
						"100%",
						"100px"
					]
				}
			},
			{
				"paragraph_10@how_to_play_common.paragraph": {
					"$text": "The beloved aug (not) is now re-added back.. but it got changed. You will walk slow with it and you will deal 12-14 damage (very high!) but when you crouch, your bullets will be very accurate and precise, but your damage lowers to 6-7."
				}
			}
		]
	},
	"sniper_section@how_to_play_common.main_sections": {
