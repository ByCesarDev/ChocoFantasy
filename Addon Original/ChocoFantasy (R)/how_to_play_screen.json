							}
						},
						{
							"pistol_button@how_to_play.pistol_button": {
								"$toggle_group_forced_index": 4
							}
						},
						{
							"shotgun_button@how_to_play.shotgun_button": {
								"$toggle_group_forced_index": 5
							}
						},
						{
							"smg_button@how_to_play.smg_button": {
								"$toggle_group_forced_index": 6
							}
						},
						{
							"rifle_button@how_to_play.rifle_button": {
								"$toggle_group_forced_index": 7
							}
						},
						{
							"sniper_button@how_to_play.sniper_button": {
								"$toggle_group_forced_index": 8
							}
						},
						{
							"other_button@how_to_play.other_button": {
								"$toggle_group_forced_index": 9
