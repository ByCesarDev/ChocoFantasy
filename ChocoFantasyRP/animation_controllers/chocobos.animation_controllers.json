{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.chocobo.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "variables": {
            "move_speed": {
              "input": "query.ground_speed * query.is_on_ground",
              "remap_curve": {
                "0.0": 0.0,
                "0.25": 1.0
              }
            }
          },
          "animations": [
            {
              "moving": "variable.move_speed"
            }
          ]
        }
      }
    },
    "controller.animation.chocobo.static": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "staticking": "query.is_on_ground && !query.is_sitting && query.ground_speed <= 0.01"
            }
          ]
        }
      }
    },
    "controller.animation.chocobo.fly": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "flying": "!query.is_on_ground && !query.is_in_water"
            }
          ]
        }
      }
    },
    "controller.animation.chocobo.sit": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "sitting": "query.is_sitting"
            }
          ]
        }
      }
    }
  }
}