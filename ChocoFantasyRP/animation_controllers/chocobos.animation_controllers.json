{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.cf_chocobo.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "moving": "query.is_on_ground && !query.is_sitting && query.property('cf:command_state') != 'sit' && query.ground_speed > 0.01"
            }
          ]
        },
        "moving": {
          "animations": [
            {
              "moving": "math.clamp(query.ground_speed * 4.0, 0.0, 1.0)"
            }
          ],
          "transitions": [
            {
              "default": "!query.is_on_ground || query.is_sitting || query.property('cf:command_state') == 'sit' || query.ground_speed <= 0.01"
            }
          ],
          "blend_transition": 0.15
        }
      }
    },
    "controller.animation.cf_chocobo.static": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "staticking": "query.is_on_ground && !query.is_sitting && query.property('cf:command_state') != 'sit' && query.ground_speed <= 0.01"
            }
          ]
        },
        "staticking": {
          "animations": [
            "staticking"
          ],
          "transitions": [
            {
              "default": "!query.is_on_ground || query.is_sitting || query.property('cf:command_state') == 'sit' || query.ground_speed > 0.01"
            }
          ],
          "blend_transition": 0.15
        }
      }
    },
    "controller.animation.cf_chocobo.fly": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "flying": "!query.is_on_ground && !query.is_in_water && !query.is_sitting && query.property('cf:command_state') != 'sit'"
            }
          ]
        },
        "flying": {
          "animations": [
            "flying"
          ],
          "transitions": [
            {
              "default": "query.is_on_ground || query.is_in_water || query.is_sitting || query.property('cf:command_state') == 'sit'"
            }
          ],
          "blend_transition": 0.15
        }
      }
    },
    "controller.animation.cf_chocobo.sit": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "sitting": "query.is_sitting || query.property('cf:command_state') == 'sit'"
            }
          ]
        },
        "sitting": {
          "animations": [
            "sitting"
          ],
          "transitions": [
            {
              "default": "!query.is_sitting && query.property('cf:command_state') != 'sit'"
            }
          ],
          "blend_transition": 0.15
        }
      }
    }
  }
}
